# Names only. Do not put real values in the repo.
# Set these on the Convex deployment: npx convex env set NAME value

# Firecrawl (required for a live county/city crawl)
FIRECRAWL_API_KEY=
FIRECRAWL_WEBHOOK_SECRET=

# AgentMail inbox + signed webhook
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
AGENTMAIL_INBOX_ID=

# OpenAI fallback when Convex AI Gateway is not available
OPENAI_API_KEY=

# Frontend (written by `npx convex dev` / static-hosting deploy)
VITE_CONVEX_URL=
